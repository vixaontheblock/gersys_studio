<section class="gallery" id="gallery">
  <div class="container">
    <div class="gallery-head">
      <p class="eyebrow">GALLERY</p>
      <h2 class="title">The Gersys Experience</h2>
    </div>

    <div class="gallery-section">
      <div class="gallery-label">
        <span>01</span>
        <h3>The Studio</h3>
      </div>

      <div class="gallery-grid studio-grid">
        <button class="gallery-item wide" data-full="/images/gallery/gersys-reception.jpg"><img src="/images/gallery/gersys-reception.jpg" alt="Recepción Gersys Hair Studio" loading="lazy" /></button>
        <button class="gallery-item" data-full="/images/gallery/gersys-lounge.jpg"><img src="/images/gallery/gersys-lounge.jpg" alt="Lounge Gersys Hair Studio" loading="lazy" /></button>
        <button class="gallery-item" data-full="/images/gallery/gersys-nails.jpg"><img src="/images/gallery/gersys-nails.jpg" alt="Área de uñas Gersys Hair Studio" loading="lazy" /></button>
        <button class="gallery-item" data-full="/images/gallery/gersys-hair-area.jpg"><img src="/images/gallery/gersys-hair-area.jpg" alt="Área de cabello Gersys Hair Studio" loading="lazy" /></button>
        <button class="gallery-item" data-full="/images/gallery/gersys-treatment-room.jpg"><img src="/images/gallery/gersys-treatment-room.jpg" alt="Área de tratamientos Gersys Hair Studio" loading="lazy" /></button>
        <button class="gallery-item wide" data-full="/images/gallery/gersys-logo-wall.jpg"><img src="/images/gallery/gersys-logo-wall.jpg" alt="Logo Gersys Hair Studio" loading="lazy" /></button>
      </div>
    </div>

    <div class="gallery-section">
      <div class="gallery-label">
        <span>02</span>
        <h3>Results</h3>
      </div>

      <div class="gallery-grid results-grid">
        <button class="gallery-item portrait" data-full="/images/gallery/gersys-balayage-1.jpg"><img src="/images/gallery/gersys-balayage-1.jpg" alt="Resultado balayage Gersys Hair Studio" loading="lazy" /></button>
        <button class="gallery-item portrait" data-full="/images/gallery/gersys-balayage-2.jpg"><img src="/images/gallery/gersys-balayage-2.jpg" alt="Resultado color Gersys Hair Studio" loading="lazy" /></button>
      </div>
    </div>

    <div class="gallery-section">
      <div class="gallery-label">
        <span>03</span>
        <h3>Mentorships</h3>
      </div>

      <div class="gallery-grid mentorship-grid">
        <button class="gallery-item wide" data-full="/images/gallery/gersys-team.jpg"><img src="/images/gallery/gersys-team.jpg" alt="Gersys Hair Studio mentorías y equipo" loading="lazy" /></button>
      </div>
    </div>
  </div>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" type="button">Cerrar</button>
    <img src="" alt="Imagen ampliada Gersys Hair Studio" />
  </div>
</section>

<style>
.gallery{
  padding:120px 0;
  background:#fff;
}

.gallery-head{
  margin-bottom:56px;
}

.eyebrow{
  font-size:.78rem;
  letter-spacing:.18em;
  margin-bottom:18px;
}

.gallery-head h2{
  font-size:clamp(3rem, 8vw, 8rem);
  max-width:1100px;
}

.gallery-section{
  padding:42px 0;
  border-top:1px solid rgba(0,0,0,.12);
}

.gallery-label{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:24px;
  margin-bottom:22px;
}

.gallery-label span{
  color:#777;
  font-size:.8rem;
}

.gallery-label h3{
  font-family:'Archivo Black', sans-serif;
  font-size:clamp(2rem, 5vw, 4.5rem);
  text-transform:uppercase;
  line-height:.9;
}

.gallery-grid{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:14px;
}

.gallery-item{
  appearance:none;
  border:none;
  padding:0;
  cursor:pointer;
  position:relative;
  overflow:hidden;
  border-radius:28px;
  background:#f5f5f5;
  min-height:310px;
}

.gallery-item.wide{
  grid-column:span 2;
}

.gallery-item.portrait{
  min-height:560px;
}

.gallery-item img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:transform .45s ease;
}

.gallery-item:hover img{
  transform:scale(1.04);
}

.results-grid{
  grid-template-columns:repeat(2, 1fr);
}

.mentorship-grid{
  grid-template-columns:1fr;
}

.mentorship-grid .gallery-item{
  min-height:520px;
}

.lightbox{
  position:fixed;
  inset:0;
  z-index:999999;
  background:rgba(0,0,0,.92);
  display:none;
  align-items:center;
  justify-content:center;
  padding:22px;
}

.lightbox.active{
  display:flex;
}

.lightbox img{
  max-width:100%;
  max-height:88svh;
  object-fit:contain;
  border-radius:18px;
}

.lightbox-close{
  position:fixed;
  top:18px;
  right:18px;
  border:none;
  background:#fff;
  color:#000;
  border-radius:999px;
  padding:13px 18px;
  font:inherit;
  cursor:pointer;
  z-index:1000000;
}

@media(max-width:900px){
  .gallery{
    padding:76px 0;
  }

  .gallery-head{
    margin-bottom:32px;
  }

  .gallery-section{
    padding:32px 0;
  }

  .gallery-label{
    align-items:flex-start;
    flex-direction:column;
    gap:8px;
  }

  .gallery-grid,
  .results-grid,
  .mentorship-grid{
    grid-template-columns:repeat(2, 1fr);
    gap:10px;
  }

  .gallery-item,
  .gallery-item.wide,
  .gallery-item.portrait,
  .mentorship-grid .gallery-item{
    grid-column:auto;
    min-height:auto;
    aspect-ratio:1 / 1.12;
    border-radius:18px;
  }

  .studio-grid .gallery-item:nth-child(1),
  .studio-grid .gallery-item:nth-child(6),
  .mentorship-grid .gallery-item{
    grid-column:span 2;
    aspect-ratio:1.55 / 1;
  }

  .gallery-item:hover img{
    transform:none;
  }
}
</style>

<script>
  const lightbox = document.querySelector("#lightbox");
  const lightboxImg = lightbox?.querySelector("img");
  const closeBtn = lightbox?.querySelector(".lightbox-close");
  const items = document.querySelectorAll(".gallery-item");

  items.forEach((item) => {
    item.addEventListener("click", () => {
      const src = item.getAttribute("data-full");

      if (!src || !lightbox || !lightboxImg) return;

      lightboxImg.src = src;
      lightbox.classList.add("active");
      document.body.style.overflow = "hidden";
    });
  });

  function closeLightbox(){
    if (!lightbox || !lightboxImg) return;

    lightbox.classList.remove("active");
    lightboxImg.src = "";
    document.body.style.overflow = "";
  }

  closeBtn?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeLightbox();
  });
</script>
