<header class="header" id="site-header">
  <div class="container header-container">
    <a href="/" class="logo" aria-label="Gersys Hair Studio">
      <img src="/images/logo-gersys.svg" alt="Gersys Hair Studio" />
    </a>

    <nav class="nav">
      <a href="#services">Servicios</a>
      <a href="#expertise">Expertise</a>
      <a href="#gallery">Galería</a>
      <a href="#location">Ubicación</a>
    </nav>

    <a
      href="https://gersyshairstudio.site.agendapro.com/pa/sucursal/351688"
      target="_blank"
      rel="noopener noreferrer"
      class="header-btn"
    >
      Reservar online
    </a>
  </div>
</header>

<style>
.header{
  position:fixed;
  top:max(14px, env(safe-area-inset-top));
  left:0;
  width:100%;
  z-index:1000;
  pointer-events:none;
  transition:transform .28s ease;
}

.header-container{
  pointer-events:auto;
  position:relative;
  z-index:1000;

  min-height:76px;
  padding:0 12px 0 18px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  border:1px solid rgba(0,0,0,.08);
  border-radius:999px;

  background:rgba(255,255,255,.74);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);

  box-shadow:0 14px 45px rgba(0,0,0,.08);

  transition:
    min-height .25s ease,
    background .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

.header.scrolled .header-container{
  min-height:64px;
  background:rgba(255,255,255,.94);
  border-color:rgba(0,0,0,.12);
  box-shadow:0 12px 40px rgba(0,0,0,.12);
}

.logo{
  display:flex;
  align-items:center;
  flex:0 0 auto;
}

.logo img{
  height:62px;
  width:auto;
  object-fit:contain;
  display:block;
  transition:height .25s ease;
}

.header.scrolled .logo img{
  height:52px;
}

.nav{
  display:flex;
  gap:6px;
  padding:6px;
  border-radius:999px;
  background:rgba(0,0,0,.045);
}

.nav a{
  padding:10px 13px;
  border-radius:999px;
  font-size:.84rem;
  color:#111;
  transition:.2s ease;
}

.nav a:hover{
  background:#000;
  color:#fff;
}

.header-btn{
  min-height:48px;
  padding:0 18px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:999px;

  background:#000;
  color:#fff;

  font-size:.88rem;
  font-weight:600;

  transition:.22s ease;
}

.header-btn:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 30px rgba(0,0,0,.18);
}

@media(max-width:860px){
  .header{
    top:max(10px, env(safe-area-inset-top));
  }

  .header-container{
    width:94%;
    min-height:66px;
    padding:0 9px 0 14px;
  }

  .header.scrolled .header-container{
    min-height:60px;
  }

  .logo img{
    height:54px;
  }

  .header.scrolled .logo img{
    height:48px;
  }

  .nav{
    display:none;
  }

  .header-btn{
    min-height:42px;
    padding:0 14px;
    font-size:.8rem;
  }
}
</style>

<script is:inline>
  const header = document.querySelector("#site-header");

  function updateHeader(){
    if (!header) return;

    if (window.scrollY > 24) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  }

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
</script>