<div class="loader" id="loader">
  <div class="loader-inner">
    <img src="/images/logo-gersys.svg" alt="Gersys Hair Studio" />
    <span>Brisas del Golf • Panamá</span>
  </div>
</div>

<style>
.loader{
  position:fixed;
  inset:0;
  z-index:2147483647;
  display:grid;
  place-items:center;
  background:#000;
  opacity:1;
  visibility:visible;
  transition:opacity .55s ease, visibility .55s ease;
}

.loader.hide{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

.loader-inner{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:18px;
  animation:loaderIn .7s ease forwards;
}

.loader-inner img{
  width:220px;
  filter:brightness(0) invert(1);
}

.loader-inner span{
  color:rgba(255,255,255,.52);
  font-size:.72rem;
  letter-spacing:.18em;
  text-transform:uppercase;
}

@keyframes loaderIn{
  from{
    opacity:0;
    transform:translateY(10px);
  }

  to{
    opacity:1;
    transform:translateY(0);
  }
}

@media(max-width:760px){
  .loader-inner img{
    width:180px;
  }
}
</style>

<script is:inline>
  const loader = document.querySelector("#loader");

  window.addEventListener("load", () => {
    setTimeout(() => {
      loader?.classList.add("hide");
    }, 900);
  });
</script>