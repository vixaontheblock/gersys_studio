---
const courses = [
 {year:'2025', name:'Open Hair Touch', type:'Full Day Training', description:'Jornada de actualización profesional en técnicas de cabello y perfeccionamiento del trabajo en salón.'},
 {year:'2024', name:'Romeu Felipe', type:'Master Class', description:'Formación enfocada en rubios, mechas y técnicas de iluminación con Romeu Felipe.'},
 {year:'2024', name:'Brûlée', type:'Master Class', description:'Parte de la formación en colorimetría y balayage realizada durante 2024.'},
 {year:'2024', name:'Diamond Pro', type:'Certificación', description:'Certificación realizada en 2024, dentro de la especialización en color y técnicas de cabello.'},
];
---
<section class="section container training" id="training" aria-labelledby="training-title">
 <div class="section-heading"><div><p class="eyebrow">Cursos y certificaciones</p><h2 id="training-title">La formación<br />también se nota.</h2></div><p>Seguir aprendiendo forma parte del trabajo. Estas son las formaciones realizadas en los últimos años.</p></div>
 <div class="training-list">{courses.map(course => <article class="training-item"><span class="training-year">{course.year} · {course.type}</span><h3>{course.name}</h3><p>{course.description}</p></article>)}</div>
 <p class="training-note">Especialización en color desde 2019. Gersys Hair Studio abrió sus puertas en Brisas del Golf en 2021.</p>
</section>
