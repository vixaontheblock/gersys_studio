---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { detailedServices, business, whatsapp } from '../../data/site';
export function getStaticPaths() { return detailedServices.map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
---
<BaseLayout title={service.title} description={service.description} service={service}><Header /><main id="main-content" class="container service-page">
 <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true"> / </span><span>{service.name}</span></nav>
 <div class="service-intro"><div><p class="eyebrow">Gersys Hair Studio · Brisas del Golf</p><h1>{service.name}<br /><em>en Brisas del Golf.</em></h1><p class="lead">{service.intro}</p><div class="actions"><a class="button" href={whatsapp(`consultar sobre ${service.name.toLowerCase()}`)} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp</a><a class="text-link" href={business.booking} target="_blank" rel="noopener noreferrer">Reservar cita</a></div></div><img src={`/images/gallery/${service.image}.webp`} alt={service.alt} width={service.image === 'gersys-balayage-2' ? 720 : 843} height={service.image === 'gersys-balayage-2' ? 1280 : 1500} fetchpriority="high" /></div>
 <div class="service-content">{service.sections?.map(section => <section><h2>{section.title}</h2><p>{section.text}</p></section>)}</div>
 <aside class="related"><h2>También en el salón</h2><div>{detailedServices.filter(s => s.slug !== service.slug).map(s => <a class="text-link" href={`/servicios/${s.slug}/`}>{s.name}</a>)}<a class="text-link" href="/#services">Todos los servicios</a></div><p>Visítanos en {business.address}, {business.locality}. <a class="text-link" href="/#location">Ver ubicación y horarios</a></p></aside>
</main><Footer /></BaseLayout>
