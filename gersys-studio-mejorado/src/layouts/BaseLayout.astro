---
import '../styles/global.css';
import { business, services } from '../data/site';
const { title = 'Gersys Hair Studio | Salón de belleza en Brisas del Golf', description = 'Balayage, color, cortes, uñas y tratamientos capilares en Brisas del Golf, Panamá. Conoce Gersys Hair Studio y reserva tu cita por WhatsApp o en línea.', image = '/images/og-gersys.jpg', service, noindex = false } = Astro.props;
const root = Astro.site!;
const canonical = new URL(Astro.url.pathname, root).href;
const fullImage = new URL(image, root).href;
const businessId = new URL('/#salon', root).href;
const salon = {
 '@type': 'BeautySalon', '@id': businessId, name: business.name,
 url: root.href, description: 'Salón de belleza en Brisas del Golf, Panamá. Balayage, color, cortes, uñas, maquillaje y tratamientos capilares.',
 telephone: business.phone, image: new URL('/images/og-gersys.jpg', root).href,
 address: { '@type': 'PostalAddress', streetAddress: business.address, addressLocality: 'Brisas del Golf', addressRegion: 'Panamá', addressCountry: 'PA' },
 areaServed: ['Brisas del Golf', 'San Miguelito', 'Panamá'], hasMap: business.maps,
 openingHoursSpecification: [
  { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '09:00', closes: '19:00' },
  { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '11:00', closes: '16:00' }
 ],
 sameAs: ['https://www.instagram.com/gersyshairstudio/', 'https://www.tiktok.com/@gersyshairstudio'],
 hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Servicios de Gersys Hair Studio', itemListElement: services.map(s => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, ...(s.slug ? { url: new URL(`/servicios/${s.slug}/`, root).href } : {}) } })) }
};
const graph: Record<string, any>[] = [salon, { '@type': 'WebSite', '@id': new URL('/#website', root).href, url: root.href, name: business.name, alternateName: 'Gersys', inLanguage: 'es-PA', publisher: { '@id': businessId } },
 { '@type': 'WebPage', '@id': canonical + '#page', url: canonical, name: title, description, inLanguage: 'es-PA', isPartOf: { '@id': new URL('/#website', root).href }, about: { '@id': businessId } }];
if (service) graph.push(
 { '@type': 'Service', '@id': canonical + '#service', name: service.name, description, url: canonical, provider: { '@id': businessId }, areaServed: 'Brisas del Golf, Panamá' },
 { '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'Inicio', item: root.href }, { '@type': 'ListItem', position: 2, name: service.name, item: canonical } ] }
);
---
<!doctype html>
<html lang="es-PA">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <link rel="canonical" href={canonical} />
  <link rel="preload" href="/fonts/archivo-black.ttf" as="font" type="font/ttf" crossorigin />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="/favicon-gersys.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={fullImage} />
  <meta property="og:image:alt" content="Gersys Hair Studio, salón de belleza en Brisas del Golf" />
  <meta property="og:locale" content="es_PA" />
  <meta property="og:site_name" content={business.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImage} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\u003c')} />
  {import.meta.env.PROD && <>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-22J5KG4VX2"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-22J5KG4VX2');</script>
  </>}
 </head>
 <body><a class="skip-link" href="#main-content">Saltar al contenido</a><slot /></body>
</html>
